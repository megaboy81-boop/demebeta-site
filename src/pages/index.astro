---
import Layout from '../layouts/Layout.astro';
import { catalogHatImages, featuredHatImages, heroImages } from '../data/siteAssets';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (src: string) => `${base}${src}`;
const hero = heroImages[0];
const supportHero = heroImages[1];
const campaignFragments = heroImages.slice(4);
const featuredCaps = featuredHatImages.slice(0, 3);
const sectionCards = [
  { href: `${base}/caps`, label: 'CAPS', sub: `${catalogHatImages.length} images`, tone: '#121212' },
  { href: `${base}/lookbook`, label: 'LOOKBOOK', sub: 'campaign stills', tone: '#555D50' },
  { href: `${base}/records`, label: 'RECORDS', sub: 'design archive', tone: '#722F37' },
];
---

<Layout title="Home" description="DEMEBETA — A Living Archive. Quiet Flex from Seongsu, Since 2021">
  <section class="home-hero">
    <img
      src={asset(hero.src)}
      alt="DEMEBETA Seongsu alley campaign image"
      width={hero.width}
      height={hero.height}
      class="home-hero__image"
      fetchpriority="high"
    />
    <div class="home-hero__shade" aria-hidden="true"></div>
    <div class="home-hero__mark">
      <span>DEMEBETA</span>
      <span>SEOUL QUIETWEAR ARCHIVE</span>
    </div>
    <div class="home-hero__copy">
      <p class="eyebrow">Seongsu, Seoul · Since 2021</p>
      <h1>DEMEBETA</h1>
      <p>성수의 조용한 리듬을 캡의 형태로 남기는 서울 기반 디자이너 캡 브랜드.</p>
    </div>
    <a class="home-hero__entry" href={`${base}/caps`}>View Caps</a>
  </section>

  <section class="brand-intro">
    <div>
      <p class="eyebrow">Quiet Caps, Built Like Records</p>
      <h2>로고보다 질감, 유행보다 착용감. DEMEBETA는 매일 쓰는 캡을 시즌의 기록으로 만든다.</h2>
    </div>
    <p>
      DEME는 로컬, BETA는 계속 진화하는 상태를 뜻한다. 부드러운 코튼 트윌, 낮은 크라운,
      절제된 워드마크와 톤온톤 자수. DEMEBETA의 캡은 크게 말하지 않지만 오래 남는 균형을 목표로 한다.
    </p>
  </section>

  <section class="home-caps">
    <div class="section-head">
      <p class="eyebrow">Selected Caps</p>
      <a href={`${base}/caps`}>View all {catalogHatImages.length}</a>
    </div>
    <div class="home-caps__grid">
      {featuredCaps.map((cap) => (
        <a href={`${base}/caps#${cap.group}`} class="home-cap">
          <img src={asset(cap.src)} alt={`${cap.id} ${cap.label}`} width={cap.width} height={cap.height} loading="lazy" />
          <span>{cap.id}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="archive-entries">
    {sectionCards.map((card) => (
      <a href={card.href} class="archive-entry" style={`--entry-tone: ${card.tone};`}>
        <span>{card.label}</span>
        <small>{card.sub}</small>
      </a>
    ))}
  </section>

  <section class="campaign-fragments">
    <div class="campaign-fragments__text">
      <p class="eyebrow">Campaign Fragments</p>
      <h2>성수의 빛, 낮은 채도, 오래 쓴 것처럼 자연스러운 캡.</h2>
    </div>
    <div class="campaign-fragments__images">
      <img src={asset(supportHero.src)} alt={supportHero.label} width={supportHero.width} height={supportHero.height} loading="lazy" />
      {campaignFragments.map((image) => (
        <img src={asset(image.src)} alt={image.label} width={image.width} height={image.height} loading="lazy" />
      ))}
    </div>
  </section>
</Layout>
