---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sectionCards = [
  { href: `${base}/lookbook`,  label: 'LOOKBOOK',  sub: '룩북',    color: '#3D3530', desc: 'Editorial Shots' },
  { href: `${base}/seasons`,   label: 'SEASONS',   sub: '시즌',    color: '#555D50', desc: 'SS26 — AW21' },
  { href: `${base}/records`,   label: 'RECORDS',   sub: '디자인 기록', color: '#722F37', desc: '30 Pieces' },
  { href: `${base}/beta`,      label: 'BETA',      sub: '실험',    color: '#2E2E2E', desc: 'Failed & On Hold' },
  { href: `${base}/materials`, label: 'MATERIALS', sub: '소재 연구', color: '#8B9B7A', desc: 'Fabric & Technique' },
];
---

<Layout title="Home" description="DEMEBETA — A Living Archive. Quiet Flex from Seongsu, Since 2021">
  <!-- ── 풀스크린 히어로 (16:9) ── -->
  <section class="relative w-full" style="aspect-ratio: 16/9; min-height: 56vw; max-height: 100vh;">
    <!-- Placeholder: 빛바랜 그라데이션 -->
    <div class="absolute inset-0 archive-photo"
         style="background: linear-gradient(135deg, #3D3530 0%, #555D50 40%, #8B9B7A 70%, #D4B5B0 100%);">
    </div>

    <!-- 오버레이 텍스트 -->
    <div class="absolute inset-0 flex flex-col justify-end px-8 md:px-14 pb-10 md:pb-14">
      <p class="font-mono text-caption tracking-[0.2em] mb-3 fade-in-up"
         style="color: rgba(249,248,246,0.4);">
        M1 placeholder — Seongsu Alley Main
      </p>
      <h1 class="font-display font-bold tracking-[0.08em] uppercase fade-in-up-d1"
          style="color: var(--text-faded); font-size: clamp(20px, 3.5vw, 48px);">
        DEMEBETA — A Living Archive
      </h1>
    </div>
  </section>

  <!-- ── 5섹션 진입 카드 (스크롤 시 페이드인) ── -->
  <section class="max-w-7xl mx-auto px-6 md:px-10 py-20 md:py-28">
    <p class="font-mono text-caption tracking-[0.25em] uppercase mb-10 md:mb-14"
       style="color: rgba(44,44,44,0.35);">
      Archive Index
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3" id="section-cards">
      {sectionCards.map((card, i) => (
        <a href={card.href}
           class={`group block p-6 md:p-7 border border-[#2C2C2C]/10 hover:border-[#2C2C2C]/30
                   transition-all duration-300 fade-in-up`}
           style={`animation-delay: ${i * 0.08}s; animation-fill-mode: both;`}>
          <!-- 컬러 도트 -->
          <div class="w-2 h-2 rounded-full mb-6 transition-transform duration-300 group-hover:scale-125"
               style={`background-color: ${card.color};`}></div>
          <p class="font-display font-bold tracking-[0.1em] text-sm uppercase mb-1"
             style="color: var(--text-ink);">
            {card.label}
          </p>
          <p class="font-kr text-caption mb-4" style="color: rgba(44,44,44,0.45);">
            {card.sub}
          </p>
          <p class="font-mono text-caption" style="color: rgba(44,44,44,0.3);">
            {card.desc}
          </p>
          <div class="mt-6 w-4 h-px transition-all duration-300 group-hover:w-full"
               style={`background-color: ${card.color};`}></div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<script>
  // IntersectionObserver로 카드 페이드인
  const cards = document.querySelectorAll('#section-cards a');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.animationPlayState = 'running';
        }
      });
    },
    { threshold: 0.1 }
  );
  cards.forEach((card) => {
    (card as HTMLElement).style.animationPlayState = 'paused';
    observer.observe(card);
  });
</script>
