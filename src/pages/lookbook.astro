---
import Layout from '../layouts/Layout.astro';
import { heroImages } from '../data/siteAssets';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (src: string) => `${base}${src}`;
const lead = heroImages[0];
const secondary = heroImages.slice(1);
---

<Layout title="Lookbook" description="DEMEBETA 룩북 — Living Archive Editorial">
  <section class="lookbook-hero">
    <img src={asset(lead.src)} alt={lead.label} width={lead.width} height={lead.height} fetchpriority="high" />
    <div>
      <p class="eyebrow">SS26 — Editorial</p>
      <h1>LOOKBOOK</h1>
    </div>
  </section>

  <section class="lookbook-grid">
    {secondary.map((image, index) => (
      <article class={index % 3 === 0 ? 'lookbook-card lookbook-card--wide' : 'lookbook-card'}>
        <img src={asset(image.src)} alt={image.label} width={image.width} height={image.height} loading="lazy" />
        <div>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{image.label}</p>
        </div>
      </article>
    ))}
  </section>
</Layout>
