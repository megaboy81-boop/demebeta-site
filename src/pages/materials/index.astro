---
import Layout from '../../layouts/Layout.astro';
import { materials, categories } from '../../data/materials';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Materials" description="DEMEBETA 소재 연구 — 자수기법, 원단, 부자재, 컬러웨이">
  <div class="flex min-h-[calc(100vh-56px)]">

    <!-- 사이드바 -->
    <aside class="w-48 md:w-56 border-r border-[#2C2C2C]/10 flex-shrink-0 pt-12 px-6">
      <p class="font-mono text-caption tracking-[0.2em] uppercase mb-6" style="color: rgba(44,44,44,0.3);">
        Category
      </p>
      <nav class="flex flex-col gap-1">
        <button data-cat="all"
                class="cat-btn text-left font-mono text-sm py-2 px-2 transition-all"
                style="color: rgba(44,44,44,0.7);">
          ALL
        </button>
        {categories.map((cat) => (
          <button data-cat={cat}
                  class="cat-btn text-left font-kr text-sm py-2 px-2 transition-all"
                  style="color: rgba(44,44,44,0.5);">
            {cat}
          </button>
        ))}
      </nav>
    </aside>

    <!-- 메인 -->
    <main class="flex-1 px-6 md:px-10 pt-12 pb-24">
      <h1 class="font-display font-bold uppercase mb-12"
          style="color: var(--text-ink); font-size: clamp(24px, 3vw, 40px);">
        MATERIALS
      </h1>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="materials-grid">
        {materials.map((m) => (
          <a href={`${base}/materials/${m.id}`}
             data-cat={m.category}
             class="material-card group border border-[#2C2C2C]/8 hover:border-[#2C2C2C]/20 transition-all duration-200">
            <!-- 컬러 스와치 -->
            <div class="h-28 archive-photo flex items-center justify-center"
                 style={`background-color: ${m.color};`}>
            </div>
            <div class="p-4">
              <div class="flex items-start justify-between mb-1">
                <div>
                  <p class="font-display text-sm font-bold uppercase" style="color: var(--text-ink);">
                    {m.nameEn}
                  </p>
                  <p class="font-kr text-caption mt-0.5" style="color: rgba(44,44,44,0.45);">
                    {m.name}
                  </p>
                </div>
                <span class="font-mono text-caption px-1.5 py-0.5 flex-shrink-0"
                      style="color: rgba(44,44,44,0.3); border: 1px solid rgba(44,44,44,0.1); font-size: 10px;">
                  {m.category}
                </span>
              </div>
              <p class="font-kr text-caption mt-3 leading-relaxed" style="color: rgba(44,44,44,0.5); font-size: 11px;">
                {m.description}
              </p>
              <p class="font-mono text-caption mt-3" style="color: rgba(44,44,44,0.3); font-size: 10px;">
                사용 디자인: {m.usedIn.length}건
              </p>
            </div>
          </a>
        ))}
      </div>
    </main>
  </div>
</Layout>

<script>
  const catBtns = document.querySelectorAll('.cat-btn');
  const cards = document.querySelectorAll('.material-card');

  catBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-cat');

      catBtns.forEach((b) => (b as HTMLElement).style.fontWeight = 'normal');
      (btn as HTMLElement).style.fontWeight = 'bold';

      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-cat');
        (card as HTMLElement).style.display =
          cat === 'all' || cardCat === cat ? 'block' : 'none';
      });
    });
  });
</script>
