---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const primaryLinks = [
  { href: `${base}/caps`,       label: 'CAPS' },
  { href: `${base}/lookbook`,   label: 'LOOKBOOK' },
  { href: `${base}/seasons`,    label: 'SEASONS' },
  { href: `${base}/records`,    label: 'RECORDS' },
  { href: `${base}/materials`,  label: 'MATERIALS' },
  { href: `${base}/beta`,       label: 'BETA' },
];

const secondaryLinks = [
  { href: `${base}/about`,      label: 'ABOUT' },
  { href: `${base}/stockists`,  label: 'STOCKISTS' },
  { href: `${base}/contact`,    label: 'CONTACT' },
];
---

<!-- 헤더 -->
<header class="sticky top-0 z-50 border-b border-[#2C2C2C]/8"
        style="background-color: rgba(249,248,246,0.92); backdrop-filter: blur(8px);">
  <div class="max-w-7xl mx-auto px-6 md:px-10">
    <div class="flex items-center justify-between h-14">
      <!-- 워드마크 -->
      <a href={`${base}/`}
         class="font-display text-base font-bold tracking-[0.18em] uppercase select-none"
         style="color: var(--text-ink);">
        DEMEBETA
      </a>

      <!-- 햄버거 (데스크탑 + 모바일 공통) -->
      <button
        id="menu-toggle"
        class="flex flex-col gap-[5px] p-2 group"
        aria-label="메뉴 열기/닫기"
        aria-expanded="false"
      >
        <span id="bar1" class="w-5 h-px block transition-all duration-300"
              style="background-color: var(--text-ink);"></span>
        <span id="bar2" class="w-5 h-px block transition-all duration-300"
              style="background-color: var(--text-ink);"></span>
        <span id="bar3" class="w-3 h-px block transition-all duration-300"
              style="background-color: var(--text-ink);"></span>
      </button>
    </div>
  </div>
</header>

<!-- 풀스크린 메뉴 오버레이 -->
<div id="fullscreen-menu"
     class="fixed inset-0 z-40 flex flex-col justify-center px-10 md:px-20"
     style="background-color: var(--bg-dark-film); opacity: 0; pointer-events: none; transition: opacity 0.35s ease;">
  <nav class="flex flex-col gap-6 mb-12">
    {primaryLinks.map((link) => (
      <a href={link.href}
         class="font-display font-bold tracking-[0.12em] transition-opacity duration-200"
         style="color: var(--text-faded); font-size: clamp(28px, 5vw, 56px); opacity: 0.9;"
         onmouseover="this.style.opacity='1'; this.style.color='#D4B5B0';"
         onmouseout="this.style.opacity='0.9'; this.style.color='#E5E5E5';"
      >
        {link.label}
      </a>
    ))}
  </nav>

  <div class="border-t border-[#E5E5E5]/10 mb-8" style="width: 100px;"></div>

  <nav class="flex flex-col gap-4">
    {secondaryLinks.map((link) => (
      <a href={link.href}
         class="font-mono tracking-[0.15em] text-sm transition-opacity duration-200"
         style="color: rgba(229,229,229,0.4);"
         onmouseover="this.style.opacity='1'; this.style.color='rgba(229,229,229,0.7)';"
         onmouseout="this.style.opacity='1'; this.style.color='rgba(229,229,229,0.4)';"
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- 닫기 버튼 (우상단) -->
  <button id="menu-close"
          class="absolute top-5 right-6 font-mono text-xs tracking-[0.2em]"
          style="color: rgba(229,229,229,0.4);"
          aria-label="메뉴 닫기">
    ESC
  </button>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('menu-close');
  const menu = document.getElementById('fullscreen-menu');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');

  let open = false;

  function openMenu() {
    open = true;
    menu!.style.opacity = '1';
    menu!.style.pointerEvents = 'auto';
    toggle!.setAttribute('aria-expanded', 'true');
    bar1!.style.transform = 'rotate(45deg) translate(4px, 4px)';
    bar2!.style.opacity = '0';
    bar3!.style.transform = 'rotate(-45deg) translate(2px, -3px)';
    bar3!.style.width = '20px';
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    open = false;
    menu!.style.opacity = '0';
    menu!.style.pointerEvents = 'none';
    toggle!.setAttribute('aria-expanded', 'false');
    bar1!.style.transform = '';
    bar2!.style.opacity = '1';
    bar3!.style.transform = '';
    bar3!.style.width = '12px';
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', () => open ? closeMenu() : openMenu());
  closeBtn?.addEventListener('click', closeMenu);

  // ESC 키
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) closeMenu();
  });

  // 메뉴 링크 클릭 시 닫기
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', closeMenu);
  });
</script>
