---
import type { Design } from '../data/designs';

interface Props {
  items: Design[];
  columns?: 2 | 3 | 4;
}
const { items, columns = 3 } = Astro.props;

const colClass = {
  2: 'grid-cols-2',
  3: 'grid-cols-2 md:grid-cols-3',
  4: 'grid-cols-2 md:grid-cols-3 lg:grid-cols-4',
}[columns];
---

<div class={`grid ${colClass} gap-4 md:gap-6`}>
  {items.map((item) => (
    <article class="group cursor-pointer">
      <!-- 이미지 (1:1 비율 placeholder) -->
      <div class="aspect-square img-placeholder analog overflow-hidden relative"
           style={`background-color: ${item.image_placeholder};`}>
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-1">
          <span class="text-[10px] tracking-[0.2em] uppercase opacity-40 font-display">
            {item.type} Cap
          </span>
          <span class="text-[11px] tracking-[0.15em] uppercase opacity-60 font-display font-medium">
            {item.id}
          </span>
        </div>
        <!-- 호버 오버레이 -->
        <div class="absolute inset-0 bg-[#1A1A1A]/0 group-hover:bg-[#1A1A1A]/10 transition-colors duration-300"></div>
      </div>

      <!-- 텍스트 -->
      <div class="mt-3 px-0.5">
        <p class="text-xs tracking-[0.08em] uppercase text-[#1A1A1A] font-medium leading-tight">
          {item.name}
        </p>
        <p class="text-xs text-[#1A1A1A]/40 mt-0.5 tracking-wide">
          {item.color} · {item.technique}
        </p>
      </div>
    </article>
  ))}
</div>
